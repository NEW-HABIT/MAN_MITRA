# ── Security & Environment ───────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Settings module (config.settings.development or config.settings.production)
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Frontend URL (used in email verification & password resets) ──────────────
FRONTEND_URL=http://localhost:3000

# ── Email SMTP Configuration (Resend) ─────────────────────────────────────────
DEFAULT_FROM_EMAIL=ManMitra <onboarding@resend.dev>
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_your_resend_api_key_here

# ── Database (Production Supabase / Neon PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── AI Configuration ─────────────────────────────────────────────────────────
AI_PROVIDER=huggingface
HF_TOKEN=your_huggingface_access_token_here

# ── CORS (Production) ─────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://man-mitra-nine.vercel.app

# ── Superuser Seed ────────────────────────────────────────────────────────────
SUPERUSER_EMAIL=admin@manmitra.ai
SUPERUSER_PASSWORD=AdminPassword123!
SUPERUSER_FULL_NAME=Admin User
